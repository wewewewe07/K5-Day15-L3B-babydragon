# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả (chưa gọi model) · gemini / openai / anthropic / ollama …
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
# Cấu hình nhóm dùng từ lượt 3 (CP4): OpenRouter · model chính gemini-3.1-flash-lite (có trong bảng giá BTC).
# Đối chứng: MODEL_NAME=google/gemini-4-hydrogen. Lượt 1–2 dùng google/gemini-2.5-flash (đã ngừng, không dùng nữa).
MODEL_PROVIDER=openrouter
MODEL_NAME=google/gemini-3.1-flash-lite
OPENAI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Giới hạn token ra mỗi lời gọi (OpenRouter giữ trước credit theo số này)
MAX_TOKENS=4096
API_KEY=
